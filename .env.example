# Azure Migration Orchestrator — example environment. Copy to .env (git-ignored). Never put secrets here.
PORT=8080
AMO_ASSESSMENT_TTL_MINUTES=120
AMO_RULES_DIR=./rules
AMO_LOG_SILENT=0

# The Azure appliance (saulpatinojr/HCW-AzMigrateOrchestrator_App) has its own .env.example.

# Coder browser workspaces (optional). Leave empty to disable the Open-in-Coder action.
CODER_URL=
CODER_SESSION_TOKEN=
CODER_TEMPLATE_ID=
AMO_WORKSPACE_PROVIDER=disabled

# Lab API edge integration (Cloudflare). TURNSTILE_SECRET is a secret: set it in the host's environment, never in a file in this repo.
AMO_ALLOWED_ORIGINS=https://hybridcloudworks.com,https://www.hybridcloudworks.com
TURNSTILE_SECRET=

# Guided lab (Coder). Leave empty to hide "Open in Coder". The token is a secret: host environment only.
AMO_PUBLIC_BASE_URL=https://labs-api.hybridcloudworks.com
