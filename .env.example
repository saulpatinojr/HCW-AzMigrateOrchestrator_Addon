# Azure Migration Orchestrator AddOn (web-front edition) — example environment. Copy to .env (git-ignored). Never put secrets here.
# On the lab host every value below is rendered by the website repository's `addons` Ansible role (docs/deployment/lab-host.md).
PORT=8080
AMO_ASSESSMENT_TTL_MINUTES=120
AMO_LOG_SILENT=0
# Built pane the API serves (default: apps/lab-web/dist relative to the repository; the image sets its own absolute path).
AMO_STATIC_DIR=

# Pane contract (HCW AddOn Integration Standard). Space-separated lists, as the host's Caddy configuration writes them.
# CSP frame-ancestors: 'none' (default) also sends X-Frame-Options: DENY. On the host it equals caddy_frame_ancestors.
AMO_FRAME_ANCESTORS='self' https://hybridcloudworks.com https://www.hybridcloudworks.com
# Site origins the pane posts hcw-addon messages to (frame-ancestors minus 'self'); published by /api/health.siteOrigins.
AMO_SITE_ORIGINS=https://hybridcloudworks.com https://www.hybridcloudworks.com
# 1 only behind the host's reverse proxy: the client address becomes the first X-Forwarded-For value (rate limiting, verification).
AMO_TRUST_PROXY=0
# Exact origins allowed to call the API cross-origin. The pane is same-origin with its API, so this stays empty on the host.
AMO_ALLOWED_ORIGINS=

# Human verification on uploads. The SECRET is a secret: host vault key vault_addon_migration_turnstile_secret, never a file in this repo.
# Without a secret, POST /api/assessments answers 503 turnstile_not_configured unless AMO_ALLOW_NO_TURNSTILE=1 (local development only).
TURNSTILE_SECRET=
# Public widget site key, published by /api/health so the pane renders the widget. Required whenever the secret is set:
# a secret without it refuses to start, and AMO_ALLOW_NO_TURNSTILE does not cover that case (it applies only without a secret).
AMO_TURNSTILE_SITE_KEY=
# Set to 1 only for local development and e2e; the deployed container never sets it.
AMO_ALLOW_NO_TURNSTILE=0
# Override of the verification endpoint; only the e2e suite sets it (tests/e2e/siteverify-mock.mjs).
AMO_TURNSTILE_SITEVERIFY_URL=

# Abuse bounds on the anonymous mutating routes: a token bucket per client address, and a cap on concurrent assessments.
AMO_RATE_LIMIT_POSTS=10
AMO_RATE_LIMIT_WINDOW_MINUTES=10
AMO_MAX_CONCURRENT=2

# Opt-in anonymised aggregate counts at /api/stats (never names, IDs, tags, subscriptions or file contents).
AMO_TELEMETRY=0

# Public base URL of this API as a guided-lab workspace would reach it (bundle download).
AMO_PUBLIC_BASE_URL=https://migration.lab.hybridcloudworks.com

# Guided lab workspaces (optional; disabled for the initial deployment). Leave empty to hide the action.
# The session token is a secret: host environment only.
AMO_WORKSPACE_PROVIDER=disabled
CODER_URL=
CODER_SESSION_TOKEN=
CODER_TEMPLATE_ID=

# The Azure appliance (saulpatinojr/HCW-AzMigrateOrchestrator_App) has its own .env.example.
