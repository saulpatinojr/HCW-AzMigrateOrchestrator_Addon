{
  "name": "hcw-azmigrateorchestrator-addon",
  "version": "0.2.0",
  "private": true,
  "description": "Hybrid Cloud Works Migration Explorer — the slim web-front edition of the Azure Migration Orchestrator: CSV lab API and site integration, built on the published core (ADR-0028) Workspace manifests use \"*\" for the two upstream packages during the interim: the exact pin is APP_REF (the upstream release tag) until the packages are installed from npm, when they become exact versions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saulpatinojr/HCW-AzMigrateOrchestrator_Addon.git"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "app:bootstrap": "bash scripts/bootstrap-app.sh",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf apps/*/dist apps/*/*.tsbuildinfo",
    "test": "npm run build && node --test \"apps/*/dist/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "test:only": "node --test \"apps/*/dist/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "typecheck": "tsc -b tsconfig.build.json --dry",
    "lab:api": "node apps/lab-api/dist/server.js",
    "e2e": "npm run build && npx playwright test",
    "package": "bash scripts/package-repository.sh"
  },
  "dependencies": {
    "@hybridcloudworks/migration-core": "file:../HCW-AzMigrateOrchestrator_App/dist-packages/migration-core",
    "@hybridcloudworks/migration-ui": "file:../HCW-AzMigrateOrchestrator_App/dist-packages/migration-ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.6.3"
  }
}
